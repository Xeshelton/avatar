# Passwort, das Besucher auf der Testseite eingeben müssen
ACCESS_PASSWORD=

# Beliebiger langer, zufälliger Text, mit dem die Login-Cookies signiert werden
# (z.B. mit "openssl rand -hex 32" erzeugen)
SESSION_SECRET=

# Tavus
TAVUS_API_KEY=
TAVUS_PAL_ID=
TAVUS_FACE_ID=

# Werden automatisch gesetzt, sobald du in Vercel unter "Storage" eine
# Upstash-Redis-Datenbank mit diesem Projekt verbindest. Hier nur zur
# lokalen Erinnerung, in Vercel selbst NICHT manuell eintragen.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
